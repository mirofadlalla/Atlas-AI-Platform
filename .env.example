# ── Required application secrets ────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=replace-with-a-long-random-secret

# Super Admin bootstrap secret.
# Used ONCE to create the first super_admin account via POST /api/super-admin/setup.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keep this secret — anyone who knows it can create a super_admin account.
SUPER_ADMIN_SECRET_KEY=replace-with-a-long-random-secret

# ── Database ─────────────────────────────────────────────────────────────────
# Credentials used by both Postgres and the application container.
POSTGRES_USER=atlas_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=atlas_db

# ── Internal services ────────────────────────────────────────────────────────
REDIS_PASSWORD=replace-with-a-strong-redis-password

# ── Embedding & environment ──────────────────────────────────────────────────
# Development uses Jina. Production loads BGE-M3 locally and falls back to Jina.
ENVIRONMENT=development
EMBEDDING_MODEL_NAME=BAAI/bge-m3
EMBEDDING_PROVIDER=jina # bge, jina, auto

# ── Optional external APIs ───────────────────────────────────────────────────
JINA_API_KEY=
GROQ_API_KEY=

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=
SENTRY_DSN=

# ── Host ports and allowed browser origin ────────────────────────────────────
API_PORT=8000
FRONTEND_URL=http://localhost:3000

# ── Production Docker image (EC2 deployments only) ───────────────────────────
# Set to the exact SHA image tag before deploying.  Never use `latest` in
# production — SHA tags are immutable and enable reliable rollbacks.
# Example: ATLAS_IMAGE=ghcr.io/mirofadlalla/atlas-ai:sha-<GITHUB_SHA>
ATLAS_IMAGE=ghcr.io/mirofadlalla/atlas-ai:sha-replace-with-git-sha
