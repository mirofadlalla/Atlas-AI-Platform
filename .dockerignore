# ==================== Secrets & Environment ====================
# Never include secrets or environment files in the image.
.env
.env.local
.env.*.local

# ==================== uv Toolchain Artifacts ====================
# Large local-only caches; never needed inside the image.
.uv-cache/
.uv-python/
.requirements-resolved.txt

# ==================== MLflow & Experiment Tracking ====================
# Local mlruns directory; production writes to the mlruns_data Docker volume.
mlruns/
mlruns

# ==================== Logs ====================
celery_worker.log
*.log
*.syslog
logs/

# ==================== Python Cache & Bytecode ====================
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# ==================== Virtual Environments ====================
venv/
.venv/
env/
ENV/

# ==================== Node & Frontend Build Artifacts ====================
# The frontend is a separate application; it is not served by the FastAPI image.
node_modules/
frontend/
.pnpm-store/
.pnpm-store

# ==================== Git & CI ====================
.git/
.gitignore
.github/

# ==================== IDE & OS Artifacts ====================
.vscode/
.idea/
.DS_Store
Thumbs.db

# ==================== Tests ====================
# Test files are not required at runtime.
tests/

# ==================== Documentation & Design Artifacts ====================
# These directories contain design docs and diagrams — not runtime files.
SRS/
digrams/
*.md

# ==================== Development Config ====================
# Linting and test config — not needed at runtime.
.flake8
pytest.ini

# ==================== Temporary & System Artifacts ====================
tmp/
.system_generated/
scratch/
write_readme.py

# ==================== Local Model Cache ====================
# HuggingFace model cache — models are downloaded at runtime or baked separately.
# If you pre-bake models, remove this exclusion and COPY the cache explicitly.
.cache/