# Required application secret. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
API_SECRET_KEY=replace-with-a-long-random-secret

# Database credentials used by both Postgres and the application container.
POSTGRES_USER=atlas_user
POSTGRES_PASSWORD=replace-with-a-strong-database-password
POSTGRES_DB=atlas_db

# Internal services
REDIS_PASSWORD=replace-with-a-strong-redis-password

# Optional external providers
JINA_API_KEY=
GROQ_API_KEY=
REMOTE_EMBED_URL=
SENTRY_DSN=

# Host ports and allowed browser origin
API_PORT=8000
FRONTEND_URL=http://localhost:3000
